{% extends 'base.html.twig' %}

{% block title %}Détails de la note
{% endblock %}

{% block body %}

	<div class="container mt-5">

		<div class="row justify-content-center">
			<div class="col-md-7">

				<div class="card shadow-sm">

					<div class="card-header bg-primary text-white">
						<h4 class="mb-0">
							Détails de la note
						</h4>
					</div>

					<div class="card-body">

						<table class="table table-bordered">
							<tbody>
								<tr>
									<th>ID</th>
									<td>{{ note.id }}</td>
								</tr>

								<tr>
									<th>Nom étudiant</th>
									<td>{{ note.nomEtudiant }}</td>
								</tr>

								<tr>
									<th>Matière</th>
									<td>{{ note.matiere }}</td>
								</tr>

								<tr>
									<th>Note</th>
									<td>
										{% if note.note >= 10 %}
											<span class="badge bg-success">
												{{ note.note }}/20
											</span>
										{% else %}
											<span class="badge bg-danger">
												{{ note.note }}/20
											</span>
										{% endif %}
									</td>
								</tr>
							</tbody>
						</table>

						<div class="d-flex gap-2 mb-3">

							<a href="{{ path('app_note_index') }}" class="btn btn-secondary">
								Retour
							</a>

							<a href="{{ path('app_note_edit', { 'id': note.id }) }}" class="btn btn-warning">
								Modifier
							</a>

						</div>

						{{ include('note/_delete_form.html.twig') }}

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
