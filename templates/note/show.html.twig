{% extends 'base.html.twig' %}

{% block title %}Détails de la note
{% endblock %}

{% block body %}

	<div class="container py-5">

		<div class="row justify-content-center">
			<div class="col-lg-7 col-md-9">

				<div
					class="card border-0 shadow-sm overflow-hidden">

					{# En-tête #}
					<div class="card-body p-4 border-bottom">

						<h3 class="fw-bold mb-2">
							Détails de la note
						</h3>

						<p class="text-muted mb-0">
							Informations concernant
							                        la note enregistrée.
						</p>

					</div>

					{# Informations #}
					<div class="card-body p-4">

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Identifiant
							</span>

							<span class="fw-semibold">
								#{{ note.id }}
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Nom de l'étudiant
							</span>

							<span class="fw-semibold">
								{{ note.nomEtudiant }}
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Matière
							</span>

							<span class="fw-semibold">
								{{ note.matiere }}
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3">

							<span class="text-muted">
								Note obtenue
							</span>

							{% if note.note >= 10 %}

								<span class="badge bg-success rounded-pill px-3 py-2">
									{{ note.note }}/20
								</span>

							{% else %}

								<span class="badge bg-danger rounded-pill px-3 py-2">
									{{ note.note }}/20
								</span>

							{% endif %}

						</div>

					</div>

					{# Boutons d'action #}
					<div class="card-footer bg-white border-top p-4">

						<div class="d-flex justify-content-between
								                                align-items-center flex-wrap gap-2">

							<div class="d-flex gap-2">

								<a href="{{ path('app_note_index') }}" class="btn btn-outline-secondary">
									← Retour
								</a>

								<a href="{{ path('app_note_edit', {'id': note.id}) }}" class="btn btn-primary">
									Modifier
								</a>

							</div>

							{{ include('note/_delete_form.html.twig') }}

						</div>

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
