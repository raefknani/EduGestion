<form method="post" action="{{ path('app_note_delete', {'id': note.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette note ? Cette action est irréversible.');">

	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">

	<button type="submit" class="btn btn-outline-danger">
		Supprimer la note
	</button>

</form>
