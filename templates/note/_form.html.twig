{{ form_start(form) }}

<div class="mb-3">
	{{ form_label(form.nomEtudiant, "Nom de l'étudiant") }}
	{{ form_widget(form.nomEtudiant, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : Ahmed Ben Ali'
        }
    }) }}
	{{ form_errors(form.nomEtudiant) }}
</div>

<div class="mb-3">
	{{ form_label(form.matiere, 'Matière') }}
	{{ form_widget(form.matiere, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : PHP Symfony'
        }
    }) }}
	{{ form_errors(form.matiere) }}
</div>

<div class="mb-3">
	{{ form_label(form.note, 'Note / 20') }}
	{{ form_widget(form.note, {
        'attr': {
            'class': 'form-control',
            'min': 0,
            'max': 20,
            'step': 0.5
        }
    }) }}
	{{ form_errors(form.note) }}
</div>

<div class="d-flex gap-2">
	<button type="submit" class="btn btn-success">
		{{ button_label|default('Enregistrer') }}
	</button>

	<a href="{{ path('app_note_index') }}" class="btn btn-secondary">
		Annuler
	</a>
</div>

{{ form_end(form) }}
