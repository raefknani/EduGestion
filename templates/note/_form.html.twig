{{ form_start(form) }}

<div class="mb-4">

	{{ form_label(form.nomEtudiant, "Nom de l'étudiant", {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.nomEtudiant, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : Ahmed Ben Ali'
        }
    }) }}

	{{ form_errors(form.nomEtudiant) }}

</div>

<div class="mb-4">

	{{ form_label(form.matiere, 'Matière', {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.matiere, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : PHP Symfony'
        }
    }) }}

	{{ form_errors(form.matiere) }}

</div>

<div class="mb-4">

	{{ form_label(form.note, 'Note / 20', {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.note, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : 15.5',
            'min': 0,
            'max': 20,
            'step': 0.5
        }
    }) }}

	{{ form_errors(form.note) }}

</div>

<div class="d-flex justify-content-end gap-2 mt-4">

	<a href="{{ path('app_note_index') }}" class="btn btn-outline-secondary">
		Annuler
	</a>

	<button type="submit" class="btn btn-primary">
		{{ button_label|default('Enregistrer') }}
	</button>

</div>

{{ form_end(form) }}
