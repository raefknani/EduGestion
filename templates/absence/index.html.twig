{% extends 'base.html.twig' %}

{% block title %}Gestion des absences
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="mb-4">Gestion des absences</h1>

		{# Search and filters #}
		<form method="get" action="{{ path('app_absence_index') }}" class="row g-2 mb-4">

			<div class="col-md-3">
				<input type="text" name="search" class="form-control" placeholder="Nom étudiant..." value="{{ search|default('') }}">
			</div>

			<div class="col-md-3">
				<input type="date" name="date" class="form-control" value="{{ date|default('') }}">
			</div>

			<div class="col-md-3">
				<select name="justifiee" class="form-select">

					<option value="">
						Toutes les absences
					</option>

					<option value="1" {% if justifiee|default('') is same as('1') %} selected {% endif %}>
						Justifiées
					</option>

					<option value="0" {% if justifiee|default('') is same as('0') %} selected {% endif %}>
						Non justifiées
					</option>

				</select>
			</div>

			<div class="col-md-3 d-flex gap-2">
				<button type="submit" class="btn btn-primary">
					Rechercher
				</button>

				<a href="{{ path('app_absence_index') }}" class="btn btn-secondary">
					Réinitialiser
				</a>
			</div>

		</form>

		{# Add absence button #}
		<a href="{{ path('app_absence_new') }}" class="btn btn-success mb-3">
			+ Ajouter une absence
		</a>

		{# Absences table #}
		<div class="table-responsive">

			<table class="table table-hover align-middle">

				<thead class="table-dark">
					<tr>
						<th>ID</th>
						<th>Nom étudiant</th>
						<th>Date d'absence</th>
						<th>Justification</th>
						<th>Actions</th>
					</tr>
				</thead>

				<tbody>

					{% for absence in absences %}

						<tr>
							<td>{{ absence.id }}</td>

							<td>{{ absence.nomEtudiant }}</td>

							<td>
								{% if absence.dateAbsence %}
									{{ absence.dateAbsence|date('d/m/Y') }}
								{% else %}
									-
								{% endif %}
							</td>

							<td>
								{% if absence.justifiee %}
									<span class="badge bg-success">
										Justifiée
									</span>
								{% else %}
									<span class="badge bg-danger">
										Non justifiée
									</span>
								{% endif %}
							</td>

							<td>
								<div class="d-flex gap-2">

									<a href="{{ path('app_absence_show', {'id': absence.id}) }}" class="btn btn-info btn-sm">
										Voir
									</a>

									<a href="{{ path('app_absence_edit', {'id': absence.id}) }}" class="btn btn-warning btn-sm">
										Modifier
									</a>

								</div>
							</td>
						</tr>

					{% else %}

						<tr>
							<td colspan="5" class="text-center py-4">
								Aucune absence trouvée
							</td>
						</tr>

					{% endfor %}

				</tbody>

			</table>

		</div>

	</div>

{% endblock %}
