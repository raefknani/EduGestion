{{ form_start(form) }}

<div class="mb-4">

	{{ form_label(form.nomEtudiant, "Nom de l'étudiant", {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.nomEtudiant, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : Ahmed Ben Ali'
        }
    }) }}

	{{ form_errors(form.nomEtudiant) }}

</div>

<div class="mb-4">

	{{ form_label(form.dateAbsence, "Date d'absence", {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.dateAbsence, {
        'attr': {
            'class': 'form-control'
        }
    }) }}

	{{ form_errors(form.dateAbsence) }}

</div>

<div class="form-check mb-4">

	{{ form_widget(form.justifiee, {
        'attr': {
            'class': 'form-check-input'
        }
    }) }}

	{{ form_label(form.justifiee, 'Absence justifiée', {
        'label_attr': {
            'class': 'form-check-label'
        }
    }) }}

	{{ form_errors(form.justifiee) }}

</div>

<div class="d-flex justify-content-end gap-2 mt-4">

	<a href="{{ path('app_absence_index') }}" class="btn btn-outline-secondary">
		Annuler
	</a>

	<button type="submit" class="btn btn-primary">
		{{ button_label|default('Enregistrer') }}
	</button>

</div>

{{ form_end(form) }}
