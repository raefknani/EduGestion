{% extends 'base.html.twig' %}

{% block title %}EduGestion - Accueil
{% endblock %}

{% block body %}

	<div
		class="container py-5">

		{# Page heading #}
		<div class="mb-5">
			<h1 class="fw-bold mb-2">Tableau de bord</h1>
			<p class="text-muted">
				Bienvenue sur EduGestion.
				            Gérez vos notes, absences et salles facilement.
			</p>
		</div>

		{# Statistics #}
		<div class="row g-4 mb-5">

			<div class="col-md-6 col-lg-3">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-muted">Notes</span>
							<span class="fs-4">📚</span>
						</div>
						<h2 class="fw-bold mt-3 mb-0 text-primary">
							{{ totalNotes }}
						</h2>
						<small class="text-muted">Notes enregistrées</small>
					</div>
				</div>
			</div>

			<div class="col-md-6 col-lg-3">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-muted">Absences</span>
							<span class="fs-4">📅</span>
						</div>
						<h2 class="fw-bold mt-3 mb-0 text-danger">
							{{ totalAbsences }}
						</h2>
						<small class="text-muted">Absences enregistrées</small>
					</div>
				</div>
			</div>

			<div class="col-md-6 col-lg-3">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-muted">Salles</span>
							<span class="fs-4">🏫</span>
						</div>
						<h2 class="fw-bold mt-3 mb-0" style="color: #7654ad;">
							{{ totalSalles }}
						</h2>
						<small class="text-muted">Total des salles</small>
					</div>
				</div>
			</div>

			<div class="col-md-6 col-lg-3">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-muted">Disponibles</span>
							<span class="fs-4">✅</span>
						</div>
						<h2 class="fw-bold mt-3 mb-0 text-success">
							{{ sallesDisponibles }}
						</h2>
						<small class="text-muted">Salles disponibles</small>
					</div>
				</div>
			</div>

		</div>

		{# Quick access #}
		<h2 class="fw-bold mb-4">Accès rapide</h2>

		<div class="row g-4">

			<div class="col-md-4">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<h4>📚 Gestion des notes</h4>
						<p class="text-muted mt-3">
							Ajouter, consulter et modifier les notes
							                        des étudiants.
						</p>
						<a href="{{ path('app_note_index') }}" class="btn btn-outline-primary mt-2">
							Gérer les notes →
						</a>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<h4>📅 Gestion des absences</h4>
						<p class="text-muted mt-3">
							Suivre les absences et gérer
							                        les justifications.
						</p>
						<a href="{{ path('app_absence_index') }}" class="btn btn-outline-primary mt-2">
							Gérer les absences →
						</a>
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="card h-100 shadow-sm">
					<div class="card-body p-4">
						<h4>🏫 Gestion des salles</h4>
						<p class="text-muted mt-3">
							Consulter les salles, leur capacité
							                        et leur disponibilité.
						</p>
						<a href="{{ path('app_salle_index') }}" class="btn btn-outline-primary mt-2">
							Gérer les salles →
						</a>
					</div>
				</div>
			</div>

		</div>

	</div>

{% endblock %}
