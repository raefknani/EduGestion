{{ form_start(form) }}

<div class="mb-4">
	{{ form_label(form.numero, 'Numéro de salle', {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.numero, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : A101'
        }
    }) }}

	{{ form_errors(form.numero) }}
</div>

<div class="mb-4">
	{{ form_label(form.capacite, "Capacité d'accueil", {
        'label_attr': {'class': 'form-label fw-semibold'}
    }) }}

	{{ form_widget(form.capacite, {
        'attr': {
            'class': 'form-control',
            'placeholder': 'Ex : 30',
            'min': 1
        }
    }) }}

	{{ form_errors(form.capacite) }}
</div>

<div class="form-check mb-4">
	{{ form_widget(form.disponible, {
        'attr': {'class': 'form-check-input'}
    }) }}

	{{ form_label(form.disponible, 'Salle disponible', {
        'label_attr': {'class': 'form-check-label'}
    }) }}

	{{ form_errors(form.disponible) }}
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
	<a href="{{ path('app_salle_index') }}" class="btn btn-outline-secondary">
		Annuler
	</a>

	<button type="submit" class="btn btn-primary">
		{{ button_label|default('Enregistrer') }}
	</button>
</div>

{{ form_end(form) }}
