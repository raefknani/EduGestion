{% extends 'base.html.twig' %}

{% block title %}Modifier une salle
{% endblock %}

{% block body %}

	<div class="container py-5">

		<div class="row justify-content-center">
			<div class="col-lg-7 col-md-9">

				<div
					class="card border-0 shadow-sm overflow-hidden">

					{# En-tête #}
					<div class="card-body p-4 border-bottom">

						<h3 class="fw-bold mb-2">
							Modifier une salle
						</h3>

						<p class="text-muted mb-0">
							Mettez à jour les informations
							                        de la salle sélectionnée.
						</p>

					</div>

					{# Formulaire de modification #}
					<div class="card-body p-4">

						{{ include('salle/_form.html.twig', {
                        'button_label': 'Enregistrer les modifications'
                    }) }}

					</div>

					{# Suppression #}
					<div class="card-footer bg-white border-top p-4">

						<div class="d-flex justify-content-end">

							{{ include('salle/_delete_form.html.twig') }}

						</div>

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
