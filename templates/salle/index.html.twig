{% extends 'base.html.twig' %}

{% block title %}Gestion des salles
{% endblock %}

{% block body %}

	<div class="container mt-4">

		<h1 class="mb-4">Gestion des salles</h1>

		{# Search and filters #}
		<form method="get" action="{{ path('app_salle_index') }}" class="row g-2 mb-4">

			<div class="col-md-3">
				<input type="text" name="search" class="form-control" placeholder="Numéro de salle..." value="{{ search|default('') }}">
			</div>

			<div class="col-md-3">
				<select name="disponible" class="form-select">

					<option value="">
						Toutes les salles
					</option>

					<option value="1" {% if disponible|default('') is same as('1') %} selected {% endif %}>
						Disponibles
					</option>

					<option value="0" {% if disponible|default('') is same as('0') %} selected {% endif %}>
						Indisponibles
					</option>

				</select>
			</div>

			<div class="col-md-3">
				<input type="number" name="capacite" min="0" class="form-control" placeholder="Capacité minimale..." value="{{ capacite|default('') }}">
			</div>

			<div class="col-md-3 d-flex gap-2">
				<button type="submit" class="btn btn-primary">
					Rechercher
				</button>

				<a href="{{ path('app_salle_index') }}" class="btn btn-secondary">
					Réinitialiser
				</a>
			</div>

		</form>

		{# Add classroom button #}
		<a href="{{ path('app_salle_new') }}" class="btn btn-success mb-3">
			+ Ajouter une salle
		</a>

		{# Classrooms table #}
		<div class="table-responsive">

			<table class="table table-hover align-middle">

				<thead class="table-dark">
					<tr>
						<th>ID</th>
						<th>Numéro de salle</th>
						<th>Capacité</th>
						<th>Disponibilité</th>
						<th>Actions</th>
					</tr>
				</thead>

				<tbody>

					{% for salle in salles %}

						<tr>
							<td>{{ salle.id }}</td>

							<td>{{ salle.numero }}</td>

							<td>
								{{ salle.capacite }}
								étudiants
							</td>

							<td>
								{% if salle.disponible %}
									<span class="badge bg-success">
										Disponible
									</span>
								{% else %}
									<span class="badge bg-danger">
										Indisponible
									</span>
								{% endif %}
							</td>

							<td>
								<div class="d-flex gap-2">

									<a href="{{ path('app_salle_show', {'id': salle.id}) }}" class="btn btn-info btn-sm">
										Voir
									</a>

									<a href="{{ path('app_salle_edit', {'id': salle.id}) }}" class="btn btn-warning btn-sm">
										Modifier
									</a>

								</div>
							</td>
						</tr>

					{% else %}

						<tr>
							<td colspan="5" class="text-center py-4">
								Aucune salle trouvée
							</td>
						</tr>

					{% endfor %}

				</tbody>

			</table>

		</div>

	</div>

{% endblock %}
