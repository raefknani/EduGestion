{% extends 'base.html.twig' %}

{% block title %}Détails de la salle
{% endblock %}

{% block body %}

	<div class="container mt-5">

		<div class="row justify-content-center">
			<div class="col-md-7">

				<div class="card shadow-sm">

					<div class="card-header bg-primary text-white">
						<h4 class="mb-0">
							Détails de la salle
						</h4>
					</div>

					<div class="card-body">

						<table class="table table-bordered">
							<tbody>

								<tr>
									<th>ID</th>
									<td>{{ salle.id }}</td>
								</tr>

								<tr>
									<th>Numéro de salle</th>
									<td>{{ salle.numero }}</td>
								</tr>

								<tr>
									<th>Capacité</th>
									<td>{{ salle.capacite }}
										étudiants</td>
								</tr>

								<tr>
									<th>Disponibilité</th>
									<td>
										{% if salle.disponible %}
											<span class="badge bg-success">
												Disponible
											</span>
										{% else %}
											<span class="badge bg-danger">
												Indisponible
											</span>
										{% endif %}
									</td>
								</tr>

							</tbody>
						</table>

						<div class="d-flex gap-2 mb-3">

							<a href="{{ path('app_salle_index') }}" class="btn btn-secondary">
								Retour
							</a>

							<a href="{{ path('app_salle_edit', { 'id': salle.id }) }}" class="btn btn-warning">
								Modifier
							</a>

						</div>

						{{ include('salle/_delete_form.html.twig') }}

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
