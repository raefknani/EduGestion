{% extends 'base.html.twig' %}

{% block title %}Détails de la salle
{% endblock %}

{% block body %}

	<div class="container py-5">

		<div class="row justify-content-center">
			<div class="col-lg-7 col-md-9">

				<div
					class="card border-0 shadow-sm overflow-hidden">

					{# Header #}
					<div class="card-body p-4 border-bottom">

						<h3 class="fw-bold mb-2">
							Détails de la salle
						</h3>

						<p class="text-muted mb-0">
							Informations concernant la salle sélectionnée.
						</p>

					</div>

					{# Classroom information #}
					<div class="card-body p-4">

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Identifiant
							</span>

							<span class="fw-semibold">
								#{{ salle.id }}
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Numéro de salle
							</span>

							<span class="fw-semibold">
								{{ salle.numero }}
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3 border-bottom">

							<span class="text-muted">
								Capacité d'accueil
							</span>

							<span class="fw-semibold">
								{{ salle.capacite }}
								étudiants
							</span>

						</div>

						<div class="d-flex justify-content-between
								                                align-items-center py-3">

							<span class="text-muted">
								Disponibilité
							</span>

							{% if salle.disponible %}
								<span class="badge bg-success rounded-pill px-3 py-2">
									Disponible
								</span>
							{% else %}
								<span class="badge bg-danger rounded-pill px-3 py-2">
									Indisponible
								</span>
							{% endif %}

						</div>

					</div>

					{# Action buttons #}
					<div class="card-footer bg-white border-top p-4">

						<div class="d-flex justify-content-between
								                                align-items-center flex-wrap gap-2">

							<div class="d-flex gap-2">

								<a href="{{ path('app_salle_index') }}" class="btn btn-outline-secondary">
									← Retour
								</a>

								<a href="{{ path('app_salle_edit', {'id': salle.id}) }}" class="btn btn-primary">
									Modifier
								</a>

							</div>

							{{ include('salle/_delete_form.html.twig') }}

						</div>

					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}
